# Copy this file to ".env" and fill in your own values. Never commit .env to GitHub.

# MongoDB connection. It must be a replica set, because ratings are saved in transactions.
# MongoDB Atlas (free) always is: https://www.mongodb.com/atlas
# Local MongoDB: see "Local MongoDB" in server/README.md
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fairview

# A long random secret used to sign login tokens and the links in emails.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

PORT=5000
JWT_EXPIRES_IN=8h

# The React app. Browsers may call the API only from here, and email links point here.
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Email. Leave SMTP_URL empty during development: emails are printed in this terminal.
# Example (Gmail with an app password): smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=FairView <no-reply@example.com>
# Shows sent emails at /api/dev/outbox and on the app's "Dev outbox" page. Ignored in production.
DEV_OUTBOX=true

# The Python ML service (see ml/README.md). Leave ML_URL empty to switch the gap analysis off.
ML_URL=http://localhost:8000
ML_API_KEY=change-me-and-use-the-same-value-in-the-ml-service

# Optional
# RATING_LINK_DAYS=14
# REMINDER_AFTER_DAYS=3
# TRUST_PROXY=1          (when running behind a proxy such as Render, Railway or Nginx)
