# Copy this file to ".env" and fill in your own values. Never commit .env to GitHub.

# MongoDB connection. Free cloud database: https://www.mongodb.com/atlas
# Or a local one: mongodb://127.0.0.1:27017/fairview
MONGODB_URI=mongodb://127.0.0.1:27017/fairview

# A long random secret used to sign login tokens.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

PORT=5000
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
