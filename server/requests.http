# FairView API: full flow, one click at a time.
# Use with the VS Code "REST Client" extension. Click "Send Request" above each block, top to bottom.
# Tokens and ids are taken automatically from earlier responses, nothing needs to be copied.
# Run `npm run seed` once before starting, and keep `npm run dev` running.

@base = http://localhost:5000/api

### 1. Client logs in
# @name clientLogin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "client@fairview.test", "password": "password123" }

### 2. Manager logs in
# @name managerLogin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "manager@fairview.test", "password": "password123" }

### 3. Priya (employee) logs in
# @name priyaLogin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "priya@fairview.test", "password": "password123" }

### 4. Client creates a project and chooses the manager
# @name project
POST {{base}}/projects
Authorization: Bearer {{clientLogin.response.body.$.token}}
Content-Type: application/json

{ "title": "Company website", "description": "5-page site", "managerId": "{{managerLogin.response.body.$.user.id}}" }

### 5. Manager gives Priya a task worth 70% of the project
# @name task
POST {{base}}/tasks
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{ "projectId": "{{project.response.body.$._id}}", "employeeId": "{{priyaLogin.response.body.$.user.id}}", "title": "Build pages", "workShare": 0.7 }

### 6. Priya starts the task
PATCH {{base}}/tasks/{{task.response.body.$._id}}/status
Authorization: Bearer {{priyaLogin.response.body.$.token}}
Content-Type: application/json

{ "status": "in_progress" }

### 7. Priya submits the task
PATCH {{base}}/tasks/{{task.response.body.$._id}}/status
Authorization: Bearer {{priyaLogin.response.body.$.token}}
Content-Type: application/json

{ "status": "submitted", "submission": "https://github.com/example/pages" }

### 8. Manager tries to deliver before rating the task -> refused (409)
POST {{base}}/projects/{{project.response.body.$._id}}/deliver
Authorization: Bearer {{managerLogin.response.body.$.token}}

### 9. Manager rates the task (before delivery, so the client's score is not known yet)
POST {{base}}/assessments
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{ "taskId": "{{task.response.body.$._id}}", "score": 5, "feedback": "Okay work" }

### 10. Manager delivers the project
POST {{base}}/projects/{{project.response.body.$._id}}/deliver
Authorization: Bearer {{managerLogin.response.body.$.token}}

### 11. Client rates the project (the rating is locked from now on)
# @name rating
POST {{base}}/ratings
Authorization: Bearer {{clientLogin.response.body.$.token}}
Content-Type: application/json

{ "projectId": "{{project.response.body.$._id}}", "score": 9, "review": "Excellent, on time" }

### 12. Manager tries to change the client rating -> must be 403
PATCH {{base}}/ratings/{{rating.response.body.$._id}}
Authorization: Bearer {{managerLogin.response.body.$.token}}
Content-Type: application/json

{ "score": 3 }

### 13. Client tries to delete their own rating -> also 403
DELETE {{base}}/ratings/{{rating.response.body.$._id}}
Authorization: Bearer {{clientLogin.response.body.$.token}}

### 14. Priya can see the client rating of the project she worked on
GET {{base}}/ratings/project/{{project.response.body.$._id}}
Authorization: Bearer {{priyaLogin.response.body.$.token}}
